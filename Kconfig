config OWLET_BLE_LED
	bool "Owlet 指示灯驱动（蓝牙 + 可选锁定灯）"
	default y

if OWLET_BLE_LED
config OWLET_BLE_LED_POLL_MS
	int "已连接时复查连接状态的周期（毫秒）"
	default 500

config OWLET_BLE_LED_BLINK_ON_MS
	int "未连接时每次点亮的时长（毫秒）"
	default 100

config OWLET_BLE_LED_BLINK_OFF_MS
	int "未连接时每次熄灭的时长（毫秒）"
	default 900

config OWLET_BLE_LED_USB_COUNTS_AS_CONNECTED
	bool "USB 已连接（HID 就绪）也视为已连接并常亮"
	default n
endif

menuconfig OWLET_USB_CHARGER_SWITCH
	bool "Owlet USB 充电器自动识别与电流配置"
	default y
	help
	  通过 FSUSB43 切换 D+/D- 并配置 BQ25601D 的输入限流与充电电流。

if OWLET_USB_CHARGER_SWITCH

config OWLET_CHARGER_SEL_GPIO_PIN
	int "FSUSB43 SEL 控制引脚（P0）"
	default 11

config OWLET_CHARGER_I2C_ADDR
	hex "BQ25601D I2C 地址"
	default 0x6B

config OWLET_CHARGER_SDP_IINDPM_MA
	int "标准电脑口 (SDP) 输入限流 (mA)"
	default 300

config OWLET_CHARGER_SDP_ICHG_MA
	int "标准电脑口 (SDP) 电池充电电流 (mA)"
	default 300

config OWLET_CHARGER_DCP_IINDPM_MA
	int "专用充电器 (DCP) 输入限流 (mA)"
	default 500

config OWLET_CHARGER_DCP_ICHG_MA
	int "专用充电器 (DCP) 电池充电电流 (mA)"
	default 500

config OWLET_CHARGER_SEL_SETTLE_MS
	int "FSUSB43 SEL 切换稳定时间 (ms)"
	default 10

config OWLET_CHARGER_DETECT_WAIT_MS
	int "BQ25601D BC1.2 检测等待时间 (ms)"
	default 100

config OWLET_CHARGER_POLL_INTERVAL_MS
	int "充电状态轮询间隔 (ms)"
	default 1000

endif # OWLET_USB_CHARGER_SWITCH
