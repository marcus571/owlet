# ============================================================
# 仓库根目录的 Kconfig
# 路径：Kconfig
#
# 2026-11-23（终版）：删除 IINDPM 配置（输入上限改由 PSEL 硬件两档决定）
#   与诊断开关；新增 MCU 看门狗（PSEL 方案的失效安全兜底）。
# ============================================================

config OWLET_BLE_LED
	bool "Owlet 指示灯驱动（蓝牙 + 可选锁定灯）"
	default y

if OWLET_BLE_LED
config OWLET_BLE_LED_POLL_MS
	int "已连接时复查连接状态的周期（毫秒）"
	default 1000

config OWLET_BLE_LED_BLINK_ON_MS
	int "未连接时每次点亮的时长（毫秒）"
	default 100

config OWLET_BLE_LED_BLINK_OFF_MS
	int "未连接时每次熄灭的时长（毫秒）"
	default 900

config OWLET_BLE_LED_USB_COUNTS_AS_CONNECTED
	bool "USB 已连接（HID 就绪）也视为已连接并常亮"
	default n
endif

menuconfig OWLET_USB_CHARGER_SWITCH
	bool "Owlet USB 充电器自动识别与电流配置"
	default y
	help
	  通过 ZMK 的 USB HID 状态判断接口类型：ICHG 设电池充电电流，
	  psel-gpios 选择输入上限档（500mA/2.4A）。

if OWLET_USB_CHARGER_SWITCH

config OWLET_CHARGER_I2C_ADDR
	hex "BQ25601 I2C 地址"
	default 0x6B

config OWLET_CHARGER_DEFAULT_ICHG_MA
	int "硬件默认充电电流 (mA)，插入瞬间回读失败时显示用"
	default 500

config OWLET_CHARGER_SDP_ICHG_MA
	int "电脑 USB 口 (SDP) 电池充电电流 (mA)，60mA 步进"
	default 600

config OWLET_CHARGER_DCP_ICHG_MA
	int "专用充电器 (DCP) 电池充电电流 (mA)，60mA 步进"
	default 1200

config OWLET_CHARGER_POLL_INTERVAL_MS
	int "充电状态轮询间隔 (ms)"
	default 15000

endif # OWLET_USB_CHARGER_SWITCH

config OWLET_WDT
	bool "Owlet MCU 看门狗（跑飞复位后 PSEL 回安全档）"
	default y
	select WATCHDOG

if OWLET_WDT
config OWLET_WDT_TIMEOUT_MS
	int "看门狗超时 (ms)"
	default 10000

config OWLET_WDT_FEED_MS
	int "喂狗周期 (ms)"
	default 3000
endif
