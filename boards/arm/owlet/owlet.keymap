/*
 * owlet 键位映射文件
 * 路径：boards/arm/owlet/owlet.keymap
 *
 * 2026-11-12 修改记录：
 *   Fn 层增加完整的 RGB 控制键（色相、饱和度、明度），EC11 在 Fn 层控制亮度。
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
	behaviors {
		/* 定义编码器行为：顺时针亮度增，逆时针亮度减 */
		rgb_encoder: rgb_encoder {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
				&mo 1       &kp CAPS      &kp KP_NUMLOCK  &kp C_MUTE
				&kp A       &kp B         &kp C           &kp D
				&kp N1      &kp N2        &kp N3          &kp N4
			>;

			/* 默认层编码器控制音量 */
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
		};

		fn_layer {
			bindings = <
				/* 第一行：饱和度减、饱和度增 */
				&trans          &rgb_ug RGB_SAD &rgb_ug RGB_SAI &trans
				/* 第二行：色相减、色相增、明度减、明度增 */
				&rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_VAD &rgb_ug RGB_VAI
				/* 第三行：切屏、RGB开关、清蓝牙、Bootloader */
				&screen_swap    &owlet_rgb_toggle &bt BT_CLR_ALL &bootloader
			>;

			/* Fn 层编码器控制亮度 */
			sensor-bindings = <&rgb_encoder>;
		};
	};
};
