/*
 * owlet 键位映射文件
 * 路径：boards/arm/owlet/owlet.keymap
 *
 * 2026-11-14 修改记录：
 *   对调 EC11 编码器方向，修正音量与亮度增减反相的问题。
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
	behaviors {
		rgb_encoder: rgb_encoder {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			/* 对调后：顺时针亮度减，逆时针亮度增 */
			bindings = <&rgb_ug RGB_BRD>, <&rgb_ug RGB_BRI>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
				&mo 1       &kp CAPS      &kp KP_NUMLOCK  &kp C_MUTE
				&kp A       &kp B         &kp C           &kp D
				&kp N1      &kp N2        &kp N3          &kp N4
			>;
			/* 对调后：顺时针音量减，逆时针音量增 */
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
		};

		fn_layer {
			bindings = <
				&trans          &trans          &trans          &trans
				&rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_HUD &rgb_ug RGB_HUI
				&screen_swap    &rgb_ug RGB_TOG &bt BT_CLR_ALL  &bootloader
			>;
			sensor-bindings = <&rgb_encoder>;
		};
	};
};
