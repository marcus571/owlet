/dts-v1/;
/*
 * owlet 板级设备树（主控小板 + 电源小板，所有键盘共享的不变量）
 * 路径：boards/arm/owlet/owlet.dts
 *
 * 2026-11-22 板/shield 拆分（2A）：键盘差异层移入 boards/shields/owlet_0。
 * 2026-11-23（终版）：int-gpios 与 psel-gpios 均为必选、由键盘 shield 声明，
 *   板级不再给 INT 默认脚（避免"漏声明静默用错脚"）；使能 WDT 节点。
 */
#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Owlet Keyboard";
	compatible = "owlet,owlet-keyboard";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &code_partition;
		zmk,battery = &max17048;
		zmk,power-control = &power_en;
	};

	aliases {
		led0 = &blue_led;
	};

	leds {
		compatible = "gpio-leds";
		blue_led: led_0 { gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>; label = "Blue LED"; };
	};

	power_en: power-enable {
		compatible = "zmk,ext-power-generic";
		control-gpios = <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		label = "External power control";
	};
};

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 6)>, <NRF_PSEL(TWIM_SDA, 0, 26)>;
			bias-pull-up;
		};
	};
	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 6)>, <NRF_PSEL(TWIM_SDA, 0, 26)>;
			bias-pull-up;
			low-power-enable;
		};
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	max17048: max17048@36 {
		compatible = "zmk,maxim-max17048";
		reg = <0x36>;
	};

	bq25601: bq25601@6b {
		compatible = "ti,bq25601";
		reg = <0x6b>;
		status = "okay";
	};
};

&gpiote { status = "okay"; };
&gpio0  { status = "okay"; };
&gpio1  { status = "okay"; };

&{/soc/watchdog@40010000} { status = "okay"; };

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";

	cdc_acm_uart: cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_0";
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		sd_partition: partition@0 { label = "softdevice"; reg = <0x00000000 0x00026000>; };
		code_partition: partition@26000 { label = "code_partition"; reg = <0x00026000 0x000c6000>; };
		storage_partition: partition@ec000 { label = "storage"; reg = <0x000ec000 0x00008000>; };
		boot_partition: partition@f4000 { label = "adafruit_boot"; reg = <0x000f4000 0x0000c000>; };
	};
};
