# ============================================================
# owlet 板默认配置文件
# 路径：boards/arm/owlet/owlet_defconfig
# ============================================================

# SoC 选择
CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y

# 基础外设
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_I2C=y
CONFIG_SPI=y
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y

# 持久化配置
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_NVS=y
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y
CONFIG_BT_SETTINGS=y
CONFIG_HWINFO=y

CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_CDC_ACM=y
CONFIG_LOG=y
CONFIG_LOG_MODE_IMMEDIATE=y
CONFIG_ZMK_USB_LOGGING=y
CONFIG_BT=y
CONFIG_BT_PERIPHERAL=y
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# NFC 引脚复用为 GPIO
CONFIG_NFCT_PINS_AS_GPIOS=y

# 外部电源控制（原生）
CONFIG_ZMK_EXT_POWER=y

# 电池燃料计
CONFIG_ZMK_MAX17048=y

# LED 指示灯底层驱动
CONFIG_LED=y
CONFIG_LED_GPIO=y
CONFIG_ZMK_HID_INDICATORS=y

# EC11 旋转编码器
CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# WS2812B RGB 灯带底层驱动
CONFIG_WS2812_STRIP=y

# RGB Underglow 上层行为配置
CONFIG_ZMK_RGB_UNDERGLOW=y
CONFIG_ZMK_RGB_UNDERGLOW_BRT_START=20
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MAX=20
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MIN=0
CONFIG_ZMK_RGB_UNDERGLOW_SAT_START=0
CONFIG_ZMK_RGB_UNDERGLOW_ON_START=y
CONFIG_ZMK_RGB_UNDERGLOW_EFF_START=0
CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE=y

# 核心联动开关：灯带控制外部电源
CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=y

# nice!view 显示底层驱动
CONFIG_ZMK_DISPLAY=y
CONFIG_LS0XX=y

# DC/DC 电源模式
CONFIG_BOARD_ENABLE_DCDC=y
CONFIG_BOARD_ENABLE_DCDC_HV=y

# 引导程序与代码分区
CONFIG_USE_DT_CODE_PARTITION=y

# 其他必需配置
CONFIG_BT_CTLR=y
CONFIG_REBOOT=y

# ============================================================
# 【关键修复】允许重启时将魔法值写入 GPREGRET 寄存器
# 配合 Nice!nano 的 Adafruit Bootloader 进入 UF2 刷机模式
# ============================================================
CONFIG_NRF_STORE_REBOOT_TYPE_GPREGRET=y
CONFIG_RETAINED_MEM=y
CONFIG_RETENTION=y

CONFIG_BUILD_OUTPUT_UF2=y
