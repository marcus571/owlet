# ============================================================
# owlet 板默认配置文件（主控 + 电源小板的基础能力）
# 路径：boards/arm/owlet/owlet_defconfig
#
# 2026-11-22（2B）：EC11/WS2812/锁定灯/HID指示灯/显示 等外设配置
#   迁入对应键盘 shield(owlet_0.conf) 与显示 shield(owlet_view.conf)，
#   板级只保留所有键盘共享的基础项，lite 版不选即不带。
# ============================================================

# SoC
CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y

# 基础外设
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_I2C=y
CONFIG_SPI=y
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y
CONFIG_FLASH_PAGE_LAYOUT=y

# 持久化
CONFIG_NVS=y
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y
CONFIG_BT_SETTINGS=y
CONFIG_HWINFO=y

# USB 设备栈（仅 HID，无 CDC ACM）
CONFIG_USB_DEVICE_STACK=y

# 蓝牙
CONFIG_BT=y
CONFIG_BT_PERIPHERAL=y
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# NFC 引脚复用
CONFIG_NFCT_PINS_AS_GPIOS=y

# 外部电源控制
CONFIG_ZMK_EXT_POWER=y

# 电池燃料计
CONFIG_ZMK_MAX17048=y

# DC/DC 电源模式
CONFIG_BOARD_ENABLE_DCDC=y
CONFIG_BOARD_ENABLE_DCDC_HV=y

# 引导程序与代码分区
CONFIG_USE_DT_CODE_PARTITION=y

# 其他必需项
CONFIG_BT_CTLR=y
CONFIG_REBOOT=y
CONFIG_WATCHDOG=y

# Bootloader 魔法值
CONFIG_NRF_STORE_REBOOT_TYPE_GPREGRET=y

# 构建输出
CONFIG_BUILD_OUTPUT_UF2=y
